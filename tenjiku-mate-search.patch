 			"uncertaintyFactor": 3,
+			"mateSearch": config_model_levels_mateSearch_tenjiku,
 			"maxDuration": 5,
 			"isDefault": true
 		},
@@ -1652,6 +1662,7 @@ exports.games = (function () {
 			"c": 0.6,
 			"ignoreLeaf": false,
 			"uncertaintyFactor": 3,
+			"mateSearch": config_model_levels_mateSearch_tenjiku,
 			"maxNodes": 60000,
 			"maxDuration": 40
 		},
@@ -1664,6 +1675,7 @@ exports.games = (function () {
 			"c": 0.6,
 			"ignoreLeaf": false,
 			"uncertaintyFactor": 3,
+			"mateSearch": config_model_levels_mateSearch_tenjiku,
 			"maxNodes": 200000,
 			"maxDuration": 120
 		},
@@ -1676,6 +1688,7 @@ exports.games = (function () {
 			"c": 0.6,
 			"ignoreLeaf": false,
 			"uncertaintyFactor": 3,
+			"mateSearch": config_model_levels_mateSearch_tenjiku,
 			"maxNodes": 1000000,
 			"maxDuration": 600
 		},
@@ -1688,6 +1701,7 @@ exports.games = (function () {
 			"c": 0.6,
 			"ignoreLeaf": false,
