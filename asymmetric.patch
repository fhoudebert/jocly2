diff --git a/examples/browser/.htaccess b/examples/browser/.htaccess
new file mode 100644
index 0000000..e2dd522
--- /dev/null
+++ b/examples/browser/.htaccess
@@ -0,0 +1,20 @@
+# Cross-origin isolation for the example pages.
+#
+# fairy-check.html talks to the bundled Fairy-Stockfish, a multi-threaded
+# wasm build that needs SharedArrayBuffer. Browsers only expose it to pages
+# served with both headers below, and they must be set on the HTML DOCUMENT -
+# a <meta http-equiv> in the page does not work for either of them, and a
+# .htaccess sitting next to the wasm files does not help the page.
+#
+# Under a server without .htaccess support, examples/browser/serve.js does the
+# same thing for local testing.
+
+<IfModule mod_headers.c>
+    Header always set Cross-Origin-Opener-Policy "same-origin"
+    Header always set Cross-Origin-Embedder-Policy "require-corp"
+    Header always set Cross-Origin-Resource-Policy "cross-origin"
+</IfModule>
+
+<IfModule mod_mime.c>
+    AddType application/wasm .wasm
+</IfModule>
